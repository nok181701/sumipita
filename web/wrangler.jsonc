// Wrangler（Cloudflare CLI）の設定ファイル。
// `wrangler deploy`実行時（CDパイプライン含む）に、Workerのエントリポイントや静的アセットの配置設定として読み込まれる。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sumipita",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // スコア・犯罪件数・ハザード値を入れる。
  // 町丁目ポリゴン（6.4MB）はここではなく静的アセットから配信する。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sumipita",
      "database_id": "PLACEHOLDER_DATABASE_ID"
    }
  ]
}
